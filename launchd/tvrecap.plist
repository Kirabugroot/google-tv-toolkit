<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>tv.toolkit.recap</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO__/.venv/bin/python</string>
		<string>-u</string>
		<string>__REPO__/discord/tvrecap.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__/discord</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>21</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>__REPO__/discord/tvrecap.log</string>
	<key>StandardErrorPath</key>
	<string>__REPO__/discord/tvrecap.log</string>
</dict>
</plist>
